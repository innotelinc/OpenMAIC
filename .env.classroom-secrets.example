# The classroom's own secrets — as references, not values.
#
# Every literal lives in Cerulean Vault (HashiCorp Vault, KV v2) at the path
# cerulean/openmaic, and this file is the deployment's view of it. Resolve it on
# the host before starting the stack:
#
#   VAULT_ADDR=http://192.168.1.71:8200 \
#   VAULT_TOKEN_FILE=/etc/classroom/vault.token \
#     node scripts/vault-env.mjs --in .env.classroom-secrets.example \
#                                 --out .env.classroom-secrets
#
# docker-compose.yml reads the result (mode 600, gitignored) as an env_file, and
# the SearXNG compose takes the same file with --env-file. A reference that
# cannot be resolved fails that command instead of writing a placeholder.

# The estate gateway's API key. This is the only credential the classroom uses
# to reach a model: chat, images, video and speech are all OmniRoute routes.
OMNIROUTE_API_KEY=vault://cerulean/openmaic#OMNIROUTE_API_KEY

# SearXNG's session secret. searxng/settings.yml deliberately carries no
# secret_key, so SearXNG takes this one and refuses to start without it.
SEARXNG_SECRET=vault://cerulean/openmaic#SEARXNG_SECRET
