# The classroom's sign-in hop — as references, not values.
#
# The values live in Cerulean Vault (HashiCorp Vault, KV v2) at
# cerulean/openmaic. Resolve them into the file compose reads:
#
#   VAULT_ADDR=http://192.168.1.71:8200 \
#   VAULT_TOKEN_FILE=/etc/classroom/vault.token \
#     node scripts/vault-env.mjs --in .env.classroom-sso.example \
#                                 --out .env.classroom-sso
#
#   docker compose --env-file .env.classroom-sso \
#     -f docker-compose.classroom-sso.yml up -d
#
# docker-compose.classroom-sso.yml names each of these variables and requires
# it, so a half-resolved file stops the deploy rather than starting the only
# door to the classroom with an empty secret.

# The Authentik application an operator signs in through (`classroom`), and the
# group it admits.
OAUTH2_PROXY_CLIENT_ID=vault://cerulean/openmaic#OAUTH2_PROXY_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET=vault://cerulean/openmaic#OAUTH2_PROXY_CLIENT_SECRET

# Signs the sealed session cookie. Rotating it signs every session out.
OAUTH2_PROXY_COOKIE_SECRET=vault://cerulean/openmaic#OAUTH2_PROXY_COOKIE_SECRET

# The Redis behind server-side sessions (a long group list overflows a 4 KB
# cookie), and the password it requires.
OAUTH2_PROXY_REDIS_CONNECTION_URL=vault://cerulean/openmaic#OAUTH2_PROXY_REDIS_CONNECTION_URL
CLASSROOM_SSO_REDIS_PASSWORD=vault://cerulean/openmaic#CLASSROOM_SSO_REDIS_PASSWORD
