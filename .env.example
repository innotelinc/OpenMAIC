# OpenMAIC — environment template.
#
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets live in Cerulean Vault (KV v2) and are referenced as
# vault://<mount>/<path>#<KEY> by the stack that resolves them.
#
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are
# Cerulean and NPM Edge. This repo does not implement any of the three.

# PostgreSQL connection
DATABASE_URL=postgres://openmaic:change-me@127.0.0.1:5432/openmaic

# OpenAI-compatible gateway
MODEL_BASE_URL=https://gateway.innotel.us/v1

# Gateway key from Cerulean Vault
MODEL_API_KEY=

# Cerulean Authentik issuer
CERULEAN_OIDC_ISSUER=https://auth.cerulean.innotel.us/application/o/classroom/
