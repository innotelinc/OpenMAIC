*.tsbuildinfo
next-env.d.ts

# IDE
.idea
.vscode

# worktrees
.worktrees

# generated data
/data
/logs

# docs
/docs
# Eval results
eval/whiteboard-layout/results/
eval/outline-language/results/
eval/orchestration/results/
eval/orchestration/results-answering/
eval/orchestration/results-answer-content/

# e2e screenshot artifacts
e2e/screenshots/

# local-only sandbox/demo pages (do not ship)
/app/slide-renderer-demo

# local e2e screenshots for #619 review
e2e/__screenshots-619/
/.playwright-mcp/

# Operator model configuration (see openmaic.yml in RFC #1701); it names secrets via ${VAR}
/openmaic.yml
# …except this deployment's own: the classroom runs every slot on the estate's
# OmniRoute gateway, with the self-hosted SearXNG and MinerU, and names each
# secret as ${VAR} (resolved from Cerulean Vault at deploy time). Tracked so the
# classroom's model configuration is reviewable and survives a rebuild.
!/openmaic.yml

# Temporary render-service sources extracted by the mixed-pool regression test
render-service/.owner-bound-parent-*/

# Local environment (never commit)
.env
.env.local
